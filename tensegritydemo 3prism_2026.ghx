              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Rhino.Geometry as rg
M = []
for item in G or []:
    if item is None:
        continue
    if hasattr(item, 'ScriptVariable'):
        item = item.ScriptVariable()
    if isinstance(item, rg.Mesh):
        M.append(item)
</item>
